# ============================================
# Link REIT Membership System - Environment Config
# 領展會員系統 - 環境配置
# ============================================

# Application
NODE_ENV=development
APP_PORT=3000
APP_NAME=link-reit-membership
APP_URL=http://localhost:3000

# Database - PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/link_reit_membership
DATABASE_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# M365 AD Integration (Azure Active Directory)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=http://localhost:3000/auth/m365-callback

# SMS Service (for HK +852 phone verification)
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=
SMS_TEMPLATE_VERIFICATION=Your verification code is {code}

# Object Storage (S3-compatible / Alibaba OSS)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=link-reit-membership
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-east-1
STORAGE_CDN_URL=

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Push Notifications
PUSH_APN_KEY=
PUSH_APN_KEY_ID=
PUSH_APN_TEAM_ID=
PUSH_FCM_SERVER_KEY=
PUSH_HMS_APP_ID=
PUSH_HMS_APP_SECRET=

# Parking System Integration
PARKING_API_URL=
PARKING_API_KEY=

# Email Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@linkreit.com

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Data Sync
GROUP_DATA_CENTER_URL=
GROUP_DATA_CENTER_API_KEY=
DATA_SYNC_INTERVAL_MINUTES=30
