// ============================================================================
// Link REIT (領展) Membership System - Prisma Schema
// Hong Kong Commercial Property Membership & Stamp (印花) System
// ============================================================================
// Multi-tenant hierarchy: Group (集团) -> Project (项目/商场) -> Merchant (商户)
// Multi-language support: zh-CN, zh-TW, en via JSON fields
// Stamp (印花) mode throughout (referred to as "points/积分" in some UIs)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
}

enum UserPortalType {
  CUSTOMER
  MERCHANT
  PROJECT
  GROUP
  SYSTEM
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
  PENDING
}

enum MemberCardStatus {
  ACTIVE
  INACTIVE
  LOST
  EXPIRED
  REPLACED
  CANCELLED
}

enum MemberRegistrationSource {
  APP
  WEBSITE
  COUNTER
  KIOSK
  IMPORT
  MIGRATION
  API
  WECHAT_MINI_PROGRAM
}

enum MemberAccountAction {
  OPEN
  CLOSE
  SUSPEND
  REACTIVATE
  MERGE
  UPGRADE
  DOWNGRADE
}

enum SpecialListType {
  WHITELIST
  BLACKLIST
  WATCHLIST
}

enum RiskAlertType {
  VELOCITY
  AMOUNT_ANOMALY
  PATTERN
  DEVICE
  LOCATION
  MERCHANT_ANOMALY
  MEMBER_ANOMALY
  SYSTEM
}

enum RiskAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskAlertStatus {
  ACTIVE
  REVIEWING
  RESOLVED
  DISMISSED
  ESCALATED
}

enum StampTransactionType {
  EARN
  REDEEM
  BONUS
  ADJUST_ADD
  ADJUST_DEDUCT
  EXPIRE
  TRANSFER_IN
  TRANSFER_OUT
  REFUND
  VOID
  CAMPAIGN_EARN
  ONLINE_ACTIVITY_EARN
}

enum StampTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  EXPIRED
}

enum StampRuleStatus {
  ACTIVE
  INACTIVE
  DRAFT
  EXPIRED
}

enum StampExpiryMode {
  FIXED_DATE
  ROLLING_DAYS
  END_OF_MONTH
  END_OF_YEAR
  NEVER
}

enum StampUpperLimitPeriod {
  PER_TRANSACTION
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  LIFETIME
