enum ParkingPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum ParkingPaymentMethod {
  ALIPAY
  WECHAT_PAY
  CREDIT_CARD
  STAMPS
  MEMBER_DISCOUNT
  FREE
}

/// ParkingRecord - Parking session records for members.
model ParkingRecord {
  id              String               @id @default(uuid()) @db.Uuid
  projectId       String               @db.Uuid
  memberId        String?              @db.Uuid
  /// License plate number
  licensePlate    String               @db.VarChar(20)
