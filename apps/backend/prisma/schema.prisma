enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

enum MerchantDataSource {
  LOCAL
  GROUP_SYNC
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum CampaignType {
  STAMP_MULTIPLIER
  BONUS_STAMP
  COUPON_DISTRIBUTION
  LUCKY_DRAW
  GIFT_REDEMPTION
  SPECIAL_EVENT
  ONLINE_ACTIVITY
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DEPLETED
}

enum CouponInstanceStatus {
  AVAILABLE
  USED
  EXPIRED
  VOIDED
  RESERVED
}

enum LuckyDrawType {
  SCRATCH_CARD
  WHEEL_SPIN
  CAPSULE_MACHINE
  RANDOM_DRAW
  INSTANT_WIN
}

enum LuckyDrawStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum LuckyDrawEntryStatus {
  PENDING
  WON
  LOST
  CLAIMED
  EXPIRED
}

enum GiftStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
