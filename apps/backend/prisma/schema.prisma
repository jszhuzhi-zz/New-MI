// ============================================================================
// ORGANIZATION - Group / OrganizationUnit / Project
// ============================================================================

/// Group (集团) - Top level tenant in the multi-tenant hierarchy.
/// Link REIT is a group that owns multiple mall projects.
model Group {
  id              String  @id @default(uuid()) @db.Uuid
  code            String  @unique @db.VarChar(50)
  /// Multi-language name: { "zh-CN": "...", "zh-TW": "...", "en": "..." }
  name            Json    @db.JsonB
  /// Multi-language description
  description     Json?   @db.JsonB
  logo            String? @db.VarChar(500)
  /// Group-wide settings: branding, features, integrations config
  settings        Json?   @db.JsonB
  /// Stamp mode configuration: base ratio, rounding, display format, etc.
  stampModeConfig Json?   @db.JsonB
  /// Contact and business info
  contactEmail    String? @db.VarChar(255)
  contactPhone    String? @db.VarChar(50)
  website         String? @db.VarChar(500)
  timezone        String  @default("Asia/Hong_Kong") @db.VarChar(50)
  currency        String  @default("HKD") @db.VarChar(10)
  isActive        Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  projects              Project[]
  organizationUnits     OrganizationUnit[]
  users                 User[]
  roles                 Role[]
  permissions           Permission[]
  merchants             Merchant[]
  memberTiers           MemberTier[]
  memberLabels          MemberLabel[]
  campaigns             Campaign[]
  coupons               Coupon[]
  gifts                 Gift[]
  notificationTemplates NotificationTemplate[]
  interfaceMonitors     InterfaceMonitor[]
  stampEarningRules     StampEarningRule[]
  stampConsumptionRules StampConsumptionRule[]
  stampExpiryRules      StampExpiryRule[]
  stampUpperLimitRules  StampUpperLimitRule[]
  stampInfos            StampInfo[]

  @@index([code])
  @@index([isActive])
  @@map("groups")
}

/// OrganizationUnit - Tree structure for organizational hierarchy within a group.
model OrganizationUnit {
  id        String  @id @default(uuid()) @db.Uuid
  groupId   String  @db.Uuid
  parentId  String? @db.Uuid
  code      String  @db.VarChar(50)
  /// Multi-language name
  name      Json    @db.JsonB
  level     Int     @default(0)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  /// Additional metadata
  metadata  Json?   @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group    Group              @relation(fields: [groupId], references: [id])
  parent   OrganizationUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrgUnitTree")
  users    User[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([parentId])
  @@index([level])
  @@map("organization_units")
}

/// Project (项目/商场) - A mall or property under a group.
model Project {
  id           String       @id @default(uuid()) @db.Uuid
  groupId      String       @db.Uuid
  code         String       @db.VarChar(50)
  /// Multi-language name
  name         Json         @db.JsonB
  /// Multi-language description
  description  Json?        @db.JsonB
  /// Multi-language address
  address      Json?        @db.JsonB
  logo         String?      @db.VarChar(500)
  coverImage   String?      @db.VarChar(500)
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  phone        String?      @db.VarChar(50)
  email        String?      @db.VarChar(255)
  /// Opening hours, facilities, features, dataSyncMode, etc.
  settings     Json?        @db.JsonB
  /// Data sync mode: whether shop data is local-only or synced from group
  dataSyncMode DataSyncMode @default(LOCAL_ONLY)
  isActive     Boolean      @default(true)
  openDate     DateTime?
  /// Geographical region within HK
  region       String?      @db.VarChar(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group                 Group                  @relation(fields: [groupId], references: [id])
  merchants             Merchant[]
  members               Member[]
  stampAccounts         StampAccount[]
  campaigns             Campaign[]
  venues                Venue[]
  floorPlans            FloorPlan[]
  contentArticles       ContentArticle[]
  serviceDirectories    ServiceDirectory[]
  banners               Banner[]
  users                 User[]
  stampEarningRules     StampEarningRule[]
  stampConsumptionRules StampConsumptionRule[]
  stampExpiryRules      StampExpiryRule[]
  stampUpperLimitRules  StampUpperLimitRule[]
  stampInfos            StampInfo[]
  luckyDraws            LuckyDraw[]
  pushNotifications     PushNotification[]
  feedbacks             Feedback[]
  parkingRecords        ParkingRecord[]
  parkingRates          ParkingRate[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([isActive])
  @@index([region])
  @@map("projects")
}

// ============================================================================
// AUTH & ACCESS - User / Role / Permission / LoginLog / AuditLog
// ============================================================================

/// User - Accounts for all portal types (customer / mall / group / merchant).
/// Supports Microsoft 365 AD integration for staff accounts.
model User {
  id           String         @id @default(uuid()) @db.Uuid
  groupId      String?        @db.Uuid
  projectId    String?        @db.Uuid
  orgUnitId    String?        @db.Uuid
  merchantId   String?        @db.Uuid
  username     String         @unique @db.VarChar(100)
  email        String?        @db.VarChar(255)
  phone        String?        @db.VarChar(50)
  passwordHash String?        @db.VarChar(255)
  portalType   UserPortalType
  status       UserStatus     @default(ACTIVE)
  /// Display name (may differ from member name)
  displayName  String?        @db.VarChar(200)
  avatar       String?        @db.VarChar(500)

  // Microsoft 365 / Azure AD integration
  m365Id           String?   @unique @db.VarChar(255)
  m365TenantId     String?   @db.VarChar(255)
  m365Email        String?   @db.VarChar(255)
  m365AccessToken  String?   @db.Text
  m365RefreshToken String?   @db.Text
  m365TokenExpiry  DateTime?

  // Security
  lastLoginAt        DateTime?
  lastLoginIp        String?   @db.VarChar(45)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)

  // Linked member (for customer portal users)
  memberId String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group           Group?            @relation(fields: [groupId], references: [id])
  project         Project?          @relation(fields: [projectId], references: [id])
  orgUnit         OrganizationUnit? @relation(fields: [orgUnitId], references: [id])
  merchant        Merchant?         @relation(fields: [merchantId], references: [id])
  member          Member?           @relation(fields: [memberId], references: [id])
  userRoles       UserRole[]
  loginLogs       LoginLog[]
  auditLogs       AuditLog[]
  operationLogs   OperationLog[]
  reportDownloads ReportDownload[]

  @@index([groupId])
  @@index([projectId])
  @@index([merchantId])
  @@index([portalType])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([m365Id])
  @@map("users")
}

/// Role - Named role with a set of permission codes.
model Role {
  id              String   @id @default(uuid()) @db.Uuid
  groupId         String   @db.Uuid
  code            String   @db.VarChar(100)
  /// Multi-language name
  name            Json     @db.JsonB
  /// Multi-language description
  description     Json?    @db.JsonB
  /// Array of permission codes assigned to this role
  permissionCodes String[]
  isSystem        Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group     Group      @relation(fields: [groupId], references: [id])
  userRoles UserRole[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([isActive])
  @@map("roles")
}

/// Permission - Hierarchical permission tree defining all system capabilities.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  groupId     String  @db.Uuid
  parentId    String? @db.Uuid
  code        String  @db.VarChar(200)
  /// Multi-language name
  name        Json    @db.JsonB
  /// Multi-language description
  description Json?   @db.JsonB
  /// Module this permission belongs to
  module      String  @db.VarChar(100)
  /// Type: menu, button, api
  type        String  @default("menu") @db.VarChar(20)
  /// Resource path or API endpoint
  resource    String? @db.VarChar(500)
  /// HTTP method for API permissions
  method      String? @db.VarChar(10)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  group    Group        @relation(fields: [groupId], references: [id])
  parent   Permission?  @relation("PermissionTree", fields: [parentId], references: [id])
  children Permission[] @relation("PermissionTree")

  @@unique([groupId, code])
  @@index([groupId])
  @@index([parentId])
  @@index([module])
  @@map("permissions")
}

/// UserRole - Many-to-many relationship between users and roles.
model UserRole {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  roleId          String    @db.Uuid
  /// Optional scope restriction: specific project or merchant
  scopeProjectId  String?   @db.Uuid
  scopeMerchantId String?   @db.Uuid
  assignedBy      String?   @db.Uuid
  assignedAt      DateTime  @default(now())
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scopeProjectId, scopeMerchantId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

/// LoginLog - Login history with IP and user agent tracking.
model LoginLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.Text
  device     String?   @db.VarChar(200)
  platform   String?   @db.VarChar(50)
  location   String?   @db.VarChar(200)
  success    Boolean   @default(true)
  failReason String?   @db.VarChar(500)
  sessionId  String?   @db.VarChar(255)

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("login_logs")
}

/// AuditLog - All write operations logged for compliance and auditing.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  action      AuditAction
  entityType  String      @db.VarChar(100)
  entityId    String?     @db.VarChar(255)
  /// Previous state (for updates/deletes)
  oldValues   Json?       @db.JsonB
  /// New state (for creates/updates)
  newValues   Json?       @db.JsonB
  /// Additional context
  metadata    Json?       @db.JsonB
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.Text
  description String?     @db.Text

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// MEMBER - Member / MemberCard / MemberTier / Labels / Change Records
// ============================================================================

/// Member - Core member entity with profile, registration source, and tags.
model Member {
  id                 String                   @id @default(uuid()) @db.Uuid
  projectId          String                   @db.Uuid
  memberNo           String                   @unique @db.VarChar(50)
  /// Multi-language name fields
  firstName          String?                  @db.VarChar(100)
  lastName           String?                  @db.VarChar(100)
  firstNameZhCN      String?                  @db.VarChar(100)
  lastNameZhCN       String?                  @db.VarChar(100)
  firstNameZhTW      String?                  @db.VarChar(100)
  lastNameZhTW       String?                  @db.VarChar(100)
  email              String?                  @db.VarChar(255)
  phone              String?                  @db.VarChar(50)
  countryCode        String?                  @default("+852") @db.VarChar(10)
  gender             Gender?
  dateOfBirth        DateTime?                @db.Date
  /// Full profile data as JSON (addresses, preferences, interests, etc.)
  profile            Json?                    @db.JsonB
  avatar             String?                  @db.VarChar(500)
  /// Preferred language
  preferredLanguage  String                   @default("zh-TW") @db.VarChar(10)
  /// Registration info
  registrationSource MemberRegistrationSource @default(APP)
  registeredAt       DateTime                 @default(now())
  /// Current tier
  tierId             String?                  @db.Uuid
  status             MemberStatus             @default(ACTIVE)
  /// Tags for segmentation (array of label IDs)
  tags               String[]
  /// Consent and opt-in flags
  marketingConsent   Boolean                  @default(false)
  dataConsent        Boolean                  @default(true)
  smsOptIn           Boolean                  @default(false)
  emailOptIn         Boolean                  @default(false)
  pushOptIn          Boolean                  @default(true)
  /// Identity verification
  idType             String?                  @db.VarChar(50)
  idNumber           String?                  @db.VarChar(100)
  isVerified         Boolean                  @default(false)
  verifiedAt         DateTime?
  /// Referral
  referralCode       String?                  @unique @db.VarChar(50)
  referredByMemberId String?                  @db.Uuid
  /// Additional metadata
  metadata           Json?                    @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  project            Project               @relation(fields: [projectId], references: [id])
  tier               MemberTier?           @relation(fields: [tierId], references: [id])
  referredBy         Member?               @relation("MemberReferral", fields: [referredByMemberId], references: [id])
  referrals          Member[]              @relation("MemberReferral")
  user               User?
  memberCards        MemberCard[]
  stampAccounts      StampAccount[]
  stampTransactions  StampTransaction[]
  changeRecords      MemberChangeRecord[]
  accountRecords     MemberAccountRecord[]
  specialListEntries SpecialListMember[]
  riskAlerts         RiskAlert[]
  couponInstances    CouponInstance[]
  luckyDrawEntries   LuckyDrawEntry[]
  giftRedemptions    GiftRedemption[]
  pushNotifications  PushNotification[]
  memberLabels       MemberMemberLabel[]
  favorites          MemberFavorite[]
  feedbacks          Feedback[]
  parkingRecords     ParkingRecord[]

  @@index([projectId])
  @@index([email])
  @@index([phone])
  @@index([tierId])
  @@index([status])
  @@index([registrationSource])
  @@index([registeredAt])
  @@index([referralCode])
  @@map("members")
}

/// MemberCard - Physical or digital card numbers with tier linking and QR/barcode.
model MemberCard {
  id               String           @id @default(uuid()) @db.Uuid
  memberId         String           @db.Uuid
  cardNumber       String           @unique @db.VarChar(50)
  tierId           String?          @db.Uuid
  status           MemberCardStatus @default(ACTIVE)
  /// Card type: physical, digital, virtual
  cardType         String           @default("digital") @db.VarChar(20)
  /// QR code content (usually the card number or a token)
  qrCode           String?          @db.VarChar(500)
  /// Barcode content
  barcode          String?          @db.VarChar(500)
  /// Barcode format: CODE128, QR, EAN13, etc.
  barcodeFormat    String?          @db.VarChar(20)
  issuedAt         DateTime         @default(now())
  activatedAt      DateTime?
  expiresAt        DateTime?
  replacedByCardId String?          @db.Uuid
  /// Additional card metadata
  metadata         Json?            @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  member Member      @relation(fields: [memberId], references: [id])
  tier   MemberTier? @relation(fields: [tierId], references: [id])

  @@index([memberId])
  @@index([cardNumber])
  @@index([tierId])
  @@index([status])
  @@map("member_cards")
}

/// MemberTier - Tier levels (Standard, Silver, Gold, Platinum, Diamond) with benefits and card design.
model MemberTier {
  id              String  @id @default(uuid()) @db.Uuid
  groupId         String  @db.Uuid
  code            String  @db.VarChar(50)
  /// Multi-language tier name
  name            Json    @db.JsonB
  /// Multi-language description
  description     Json?   @db.JsonB
  /// Tier level number (higher = better)
  level           Int     @default(0)
  /// Minimum stamps required to reach/maintain this tier
  minStamps       Int     @default(0)
  /// Maximum stamps for this tier range (null = no upper limit)
  maxStamps       Int?
  /// Benefits configuration (parking, discounts, lounges, etc.)
  benefits        Json?   @db.JsonB
  /// Card visual design (colors, background, template)
  cardDesign      Json?   @db.JsonB
  /// Stamp multiplier for this tier (e.g., Gold gets 1.5x)
  stampMultiplier Decimal @default(1.0) @db.Decimal(5, 2)
  /// Tier icon/badge image
  icon            String? @db.VarChar(500)
  /// Tier color for display
  color           String? @db.VarChar(20)
  isDefault       Boolean @default(false)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group       Group        @relation(fields: [groupId], references: [id])
  members     Member[]
  memberCards MemberCard[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([level])
  @@index([isActive])
  @@map("member_tiers")
}

/// MemberLabel - Tags/labels for member segmentation.
model MemberLabel {
  id        String  @id @default(uuid()) @db.Uuid
  groupId   String  @db.Uuid
  code      String  @db.VarChar(50)
  /// Multi-language label name
  name      Json    @db.JsonB
  /// Label category (e.g., lifestyle, spending_level, demographics)
  category  String? @db.VarChar(100)
  color     String? @db.VarChar(20)
  icon      String? @db.VarChar(500)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group        Group               @relation(fields: [groupId], references: [id])
  members      MemberMemberLabel[]
  autoTagRules AutoTagRule[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([category])
  @@map("member_labels")
}

/// MemberMemberLabel - Many-to-many between Member and MemberLabel.
model MemberMemberLabel {
  id         String   @id @default(uuid()) @db.Uuid
  memberId   String   @db.Uuid
  labelId    String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  // Relations
  member Member      @relation(fields: [memberId], references: [id])
  label  MemberLabel @relation(fields: [labelId], references: [id])

  @@unique([memberId, labelId])
  @@index([memberId])
  @@index([labelId])
  @@map("member_member_labels")
}

/// MemberChangeRecord - All changes to member data tracked for auditing.
model MemberChangeRecord {
  id           String  @id @default(uuid()) @db.Uuid
  memberId     String  @db.Uuid
  fieldName    String  @db.VarChar(100)
  oldValue     String? @db.Text
  newValue     String? @db.Text
  changedBy    String? @db.Uuid
  changeReason String? @db.VarChar(500)
  /// Source: admin, self-service, api, import, system
  source       String  @default("admin") @db.VarChar(50)

  createdAt DateTime @default(now())

  // Relations
  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([fieldName])
  @@index([createdAt])
  @@map("member_change_records")
}

/// MemberAccountRecord - Open/close/suspend/reactivate records.
model MemberAccountRecord {
