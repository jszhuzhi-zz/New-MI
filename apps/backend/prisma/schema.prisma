  relatedEntityType String?            @db.VarChar(100)
  relatedEntityId   String?            @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([smsType])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@map("sms_send_records")
}

