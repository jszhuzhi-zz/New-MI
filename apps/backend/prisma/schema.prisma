// ============================================================================
// RISK CONTROL (风控中心) - Alerts, Rules
// ============================================================================

/// RiskAlert - Risk alert entries for anomaly detection and fraud monitoring.
model RiskAlert {
  id            String            @id @default(uuid()) @db.Uuid
  groupId       String            @db.Uuid
  projectId     String?           @db.Uuid
  type          RiskAlertType
  severity      RiskAlertSeverity
  status        RiskAlertStatus   @default(ACTIVE)
  memberId      String?           @db.Uuid
  merchantId    String?           @db.Uuid
  transactionId String?           @db.Uuid
  /// Multi-language description
  description   Json              @db.JsonB
  /// Detailed alert data (anomaly details, thresholds, etc.)
  details       Json?             @db.JsonB
  /// Risk score (0-100)
  score         Decimal?          @db.Decimal(5, 2)
  /// Reviewer user ID
  reviewedBy    String?           @db.Uuid
  /// Review notes
  reviewNotes   String?           @db.Text
  reviewedAt    DateTime?
  resolvedAt    DateTime?

  createdAt DateTime @default(now())

  // Relations
  member   Member?  @relation(fields: [memberId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([groupId])
  @@index([projectId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([memberId])
  @@index([merchantId])
  @@index([createdAt])
  @@map("risk_alerts")
}

/// RiskRule - Risk control rule definitions for automated anomaly detection.
model RiskRule {
  id              String   @id @default(uuid()) @db.Uuid
  groupId         String   @db.Uuid
  projectId       String?  @db.Uuid
  code            String   @db.VarChar(100)
  /// Multi-language rule name
  name            Json     @db.JsonB
  /// Rule type: velocity, amount, pattern, device, location, time
  type            String   @db.VarChar(50)
  /// Rule conditions (JSON array of condition objects)
  conditions      Json     @db.JsonB
  /// Action to take: flag, block, suspend-member, notify-staff, escalate
  action          String   @db.VarChar(50)
  /// Severity: LOW, MEDIUM, HIGH, CRITICAL
  severity        String   @db.VarChar(20)
  isActive        Boolean  @default(true)
  priority        Int      @default(0)
  /// Cooldown period in minutes before rule can trigger again for same entity
  cooldownMinutes Int      @default(0)
  /// Additional rule metadata
  metadata        Json?    @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([type])
  @@index([isActive])
  @@map("risk_rules")
}

// ============================================================================
// STAMP SYSTEM (印花体系) - Accounts, Transactions, Rules
// ============================================================================

/// StampAccount - Stamp balance per member per project.
model StampAccount {
  id              String  @id @default(uuid()) @db.Uuid
  memberId        String  @db.Uuid
  projectId       String  @db.Uuid
  /// Current available stamp balance
  balance         Decimal @default(0) @db.Decimal(15, 2)
  /// Total stamps ever earned
  totalEarned     Decimal @default(0) @db.Decimal(15, 2)
  /// Total stamps ever redeemed/used
  totalRedeemed   Decimal @default(0) @db.Decimal(15, 2)
  /// Total stamps expired
  totalExpired    Decimal @default(0) @db.Decimal(15, 2)
  /// Total stamps adjusted (net)
  totalAdjusted   Decimal @default(0) @db.Decimal(15, 2)
  /// Pending stamps (not yet available)
  pendingBalance  Decimal @default(0) @db.Decimal(15, 2)
  /// Stamps expiring soon (within next 30 days)
  expiringBalance Decimal @default(0) @db.Decimal(15, 2)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  member       Member             @relation(fields: [memberId], references: [id])
  project      Project            @relation(fields: [projectId], references: [id])
  transactions StampTransaction[]

  @@unique([memberId, projectId])
  @@index([memberId])
  @@index([projectId])
  @@index([balance])
  @@map("stamp_accounts")
}

/// StampTransaction - All stamp movements (earn/redeem/bonus/adjust/expire/transfer/refund).
model StampTransaction {
  id                    String                 @id @default(uuid()) @db.Uuid
  stampAccountId        String                 @db.Uuid
  memberId              String                 @db.Uuid
  transactionType       StampTransactionType
  status                StampTransactionStatus @default(COMPLETED)
  /// Positive for credits, negative for debits
  amount                Decimal                @db.Decimal(15, 2)
  /// Balance after this transaction
  balanceAfter          Decimal                @db.Decimal(15, 2)
  /// Reference number for external tracking
  referenceNo           String?                @db.VarChar(100)
  /// External transaction/receipt number
  externalRef           String?                @db.VarChar(200)
  /// Multi-language description
  description           Json?                  @db.JsonB
  /// Source merchant for earn transactions
  merchantId            String?                @db.Uuid
  /// Spending amount that generated these stamps
  spendingAmount        Decimal?               @db.Decimal(15, 2)
  /// Applied earning rule
  earningRuleId         String?                @db.Uuid
  /// Applied campaign rule
  campaignId            String?                @db.Uuid
  /// Related coupon instance (if stamps used for coupon)
  couponInstanceId      String?                @db.Uuid
  /// Related gift redemption
  giftRedemptionId      String?                @db.Uuid
  /// Stamps expiry date for this batch
  expiresAt             DateTime?
  /// For void/refund: the original transaction being reversed
  originalTransactionId String?                @db.Uuid
  /// Who processed this transaction
  processedBy           String?                @db.Uuid
  /// Channel: app, pos, admin, api, system
  channel               String?                @db.VarChar(50)
  /// Additional metadata
  metadata              Json?                  @db.JsonB
  /// Remark from operator
  remark                String?                @db.Text

  transactionAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  stampAccount StampAccount      @relation(fields: [stampAccountId], references: [id])
  member       Member            @relation(fields: [memberId], references: [id])
  merchant     Merchant?         @relation(fields: [merchantId], references: [id])
  earningRule  StampEarningRule? @relation(fields: [earningRuleId], references: [id])
  campaign     Campaign?         @relation(fields: [campaignId], references: [id])

  @@index([stampAccountId])
  @@index([memberId])
  @@index([transactionType])
  @@index([status])
  @@index([merchantId])
  @@index([campaignId])
  @@index([referenceNo])
  @@index([transactionAt])
  @@index([expiresAt])
  @@map("stamp_transactions")
}

/// StampEarningRule - Rules for earning stamps from spending.
model StampEarningRule {
  id                 String          @id @default(uuid()) @db.Uuid
  groupId            String          @db.Uuid
  projectId          String?         @db.Uuid
  code               String          @db.VarChar(50)
  /// Multi-language rule name
  name               Json            @db.JsonB
  /// Multi-language description
  description        Json?           @db.JsonB
  /// Spending amount per stamp (e.g., HKD 100 = 1 stamp)
  spendingPerStamp   Decimal         @db.Decimal(15, 2)
  /// Minimum spending amount to qualify
  minSpending        Decimal?        @db.Decimal(15, 2)
  /// Maximum stamps earnable per transaction
  maxStampsPerTx     Int?
  /// Merchant category restrictions (JSON array)
  merchantCategories Json?           @db.JsonB
  /// Specific merchant restrictions
  merchantIds        String[]
  /// Applicable member tiers (empty = all tiers)
  applicableTierIds  String[]
  /// Day-of-week restrictions (0=Sun, 6=Sat)
  applicableDays     Int[]
  /// Time range restrictions
  startTime          String?         @db.VarChar(5)
  endTime            String?         @db.VarChar(5)
  /// Rounding mode: floor, ceil, round
  roundingMode       String          @default("floor") @db.VarChar(10)
  priority           Int             @default(0)
  status             StampRuleStatus @default(ACTIVE)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  /// Additional rule configuration
  ruleConfig         Json?           @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group              Group               @relation(fields: [groupId], references: [id])
  project            Project?            @relation(fields: [projectId], references: [id])
  transactions       StampTransaction[]
  campaignStampRules CampaignStampRule[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
  @@map("stamp_earning_rules")
}

/// StampConsumptionRule - Rules for using/redeeming stamps.
model StampConsumptionRule {
  id                String          @id @default(uuid()) @db.Uuid
  groupId           String          @db.Uuid
  projectId         String?         @db.Uuid
  code              String          @db.VarChar(50)
  /// Multi-language rule name
  name              Json            @db.JsonB
  /// Multi-language description
  description       Json?           @db.JsonB
  /// Minimum stamps required to redeem
  minStamps         Int             @default(1)
  /// Stamps must be redeemed in multiples of
  stepSize          Int             @default(1)
  /// What can stamps be used for: coupon, gift, cash_value, parking
  consumptionType   String          @db.VarChar(50)
  /// Stamps-to-value ratio (e.g., 10 stamps = HKD 1)
  stampsPerUnit     Decimal?        @db.Decimal(15, 2)
  /// Applicable member tiers
  applicableTierIds String[]
  status            StampRuleStatus @default(ACTIVE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  /// Additional configuration
  ruleConfig        Json?           @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group   Group    @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@map("stamp_consumption_rules")
}

/// StampExpiryRule - Rules for stamp expiry and clearing.
model StampExpiryRule {
  id                 String          @id @default(uuid()) @db.Uuid
  groupId            String          @db.Uuid
  projectId          String?         @db.Uuid
  code               String          @db.VarChar(50)
  /// Multi-language rule name
  name               Json            @db.JsonB
  /// Expiry mode
  expiryMode         StampExpiryMode
  /// For FIXED_DATE: the date stamps expire
  fixedExpiryDate    DateTime?
  /// For ROLLING_DAYS: number of days after earning
  rollingDays        Int?
  /// For END_OF_MONTH/YEAR: months/years after earning
  rollingPeriods     Int?
  /// Grace period in days before actual expiry
  gracePeriodDays    Int             @default(0)
  /// Whether to send notification before expiry
  notifyBeforeExpiry Boolean         @default(true)
  /// Days before expiry to send notification
  notifyDaysBefore   Int             @default(30)
  status             StampRuleStatus @default(ACTIVE)
  effectiveFrom      DateTime
  effectiveTo        DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group   Group    @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@map("stamp_expiry_rules")
}

/// StampUpperLimitRule - Caps per transaction/day/month/year/lifetime.
model StampUpperLimitRule {
  id                String                @id @default(uuid()) @db.Uuid
  groupId           String                @db.Uuid
  projectId         String?               @db.Uuid
  code              String                @db.VarChar(50)
  /// Multi-language rule name
  name              Json                  @db.JsonB
  /// Which period this limit applies to
  period            StampUpperLimitPeriod
  /// Maximum stamp amount for this period
  maxAmount         Decimal               @db.Decimal(15, 2)
  /// Applicable member tiers (empty = all)
  applicableTierIds String[]
  status            StampRuleStatus       @default(ACTIVE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group   Group    @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([period])
  @@index([status])
  @@map("stamp_upper_limit_rules")
}

/// CampaignStampRule - Campaign-specific stamp rules (multipliers, bonus stamps).
model CampaignStampRule {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @db.Uuid
  earningRuleId String?  @db.Uuid
  /// Multiplier to apply on top of base earning (e.g., 2.0 = double stamps)
  multiplier    Decimal? @db.Decimal(5, 2)
  /// Fixed bonus stamps to add
  bonusStamps   Decimal? @db.Decimal(15, 2)
  /// Conditions for this campaign rule (spending thresholds, categories, etc.)
  conditions    Json?    @db.JsonB
  priority      Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaign    Campaign          @relation(fields: [campaignId], references: [id])
  earningRule StampEarningRule? @relation(fields: [earningRuleId], references: [id])

  @@index([campaignId])
  @@index([earningRuleId])
  @@map("campaign_stamp_rules")
}

/// OnlineActivityStampRule - Online activity stamp rules (check-in, survey, social share, etc.).
model OnlineActivityStampRule {
  id                String          @id @default(uuid()) @db.Uuid
  campaignId        String?         @db.Uuid
  code              String          @db.VarChar(50)
  /// Multi-language name
  name              Json            @db.JsonB
  /// Activity type: check_in, survey, social_share, referral, profile_complete, game, qr_scan
  activityType      String          @db.VarChar(50)
  /// Stamps awarded per completion
  stampsPerAction   Decimal         @db.Decimal(15, 2)
  /// Max times a member can earn from this activity
  maxTimesPerMember Int?
  /// Max times per day
  maxTimesPerDay    Int?
  /// Applicable tiers
  applicableTierIds String[]
  status            StampRuleStatus @default(ACTIVE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  /// Additional config
  ruleConfig        Json?           @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([campaignId])
  @@index([activityType])
  @@index([status])
  @@map("online_activity_stamp_rules")
}

/// StampInfo - Stamp info display items (help text, FAQs, explanations).
model StampInfo {
  id        String  @id @default(uuid()) @db.Uuid
  groupId   String  @db.Uuid
  projectId String? @db.Uuid
  code      String  @db.VarChar(50)
  /// Multi-language title
  title     Json    @db.JsonB
  /// Multi-language content (rich text)
  content   Json    @db.JsonB
  /// Category: faq, help, terms, guide
  category  String  @db.VarChar(50)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group   Group    @relation(fields: [groupId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([category])
  @@map("stamp_infos")
}

// ============================================================================
// MERCHANT - Merchant / MerchantAccount
// ============================================================================

/// Merchant - Stores/shops in malls. Data can be local or synced from group data center.
model Merchant {
  id                String             @id @default(uuid()) @db.Uuid
  groupId           String             @db.Uuid
  projectId         String             @db.Uuid
  code              String             @db.VarChar(50)
  /// Multi-language merchant name
  name              Json               @db.JsonB
  /// Multi-language description
  description       Json?              @db.JsonB
  /// Multi-language short description
  shortDescription  Json?              @db.JsonB
  logo              String?            @db.VarChar(500)
  coverImage        String?            @db.VarChar(500)
  images            String[]
  /// Category: F&B, fashion, lifestyle, services, etc.
  category          String?            @db.VarChar(100)
  subCategory       String?            @db.VarChar(100)
  /// Floor and unit info
  floor             String?            @db.VarChar(20)
  unit              String?            @db.VarChar(50)
  phone             String?            @db.VarChar(50)
  email             String?            @db.VarChar(255)
  website           String?            @db.VarChar(500)
  /// Opening hours as structured JSON
  openingHours      Json?              @db.JsonB
  /// Whether this merchant participates in stamp program
  stampEnabled      Boolean            @default(true)
  /// Data source: locally managed or synced from group data center
  dataSource        MerchantDataSource @default(LOCAL)
  /// External ID from group data center (for synced merchants)
  externalId        String?            @db.VarChar(255)
  /// Last sync timestamp
  lastSyncedAt      DateTime?
  status            MerchantStatus     @default(ACTIVE)
  /// Contract dates
  contractStartDate DateTime?
  contractEndDate   DateTime?
  /// Additional metadata
  metadata          Json?              @db.JsonB
  sortOrder         Int                @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group             Group              @relation(fields: [groupId], references: [id])
  project           Project            @relation(fields: [projectId], references: [id])
  merchantAccounts  MerchantAccount[]
  stampTransactions StampTransaction[]
  riskAlerts        RiskAlert[]
  users             User[]
  favoritedBy       MemberFavorite[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([category])
  @@index([status])
  @@index([dataSource])
  @@index([externalId])
  @@map("merchants")
}

/// MerchantAccount - Staff accounts for the merchant portal.
model MerchantAccount {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  name        String   @db.VarChar(200)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  /// Role within merchant: owner, manager, staff
  role        String   @default("staff") @db.VarChar(50)
  isActive    Boolean  @default(true)
  /// Permissions specific to merchant portal operations
  permissions String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([email])
  @@map("merchant_accounts")
}

// ============================================================================
// CAMPAIGN & PROMOTIONS - Campaign / Coupon / LuckyDraw / Gift
// ============================================================================

/// Campaign - Activities/promotions with audience targeting.
model Campaign {
  id                    String         @id @default(uuid()) @db.Uuid
  groupId               String         @db.Uuid
  projectId             String?        @db.Uuid
  code                  String         @db.VarChar(50)
  /// Multi-language campaign name
  name                  Json           @db.JsonB
  /// Multi-language description
  description           Json?          @db.JsonB
  /// Multi-language short description for listings
  shortDescription      Json?          @db.JsonB
  /// Multi-language terms and conditions
  termsConditions       Json?          @db.JsonB
  coverImage            String?        @db.VarChar(500)
  images                String[]
  campaignType          CampaignType
  status                CampaignStatus @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  /// Registration/participation period (may differ from campaign period)
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  /// Target audience criteria (tier, labels, demographics, etc.)
  audienceTargeting     Json?          @db.JsonB
  /// Budget and limits
  totalBudget           Decimal?       @db.Decimal(15, 2)
  maxParticipants       Int?
  currentParticipants   Int            @default(0)
  /// Campaign-specific settings
  settings              Json?          @db.JsonB
  /// Approval workflow
  approvedBy            String?        @db.Uuid
  approvedAt            DateTime?
  rejectedReason        String?        @db.Text
  /// Analytics summary (cached)
  analyticsSummary      Json?          @db.JsonB

  createdBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group              Group               @relation(fields: [groupId], references: [id])
  project            Project?            @relation(fields: [projectId], references: [id])
  stampTransactions  StampTransaction[]
  campaignStampRules CampaignStampRule[]
  coupons            Coupon[]
  luckyDraws         LuckyDraw[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([campaignType])
  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

/// Coupon - Coupon templates.
model Coupon {
  id                    String       @id @default(uuid()) @db.Uuid
  groupId               String       @db.Uuid
  campaignId            String?      @db.Uuid
  code                  String       @db.VarChar(50)
  /// Multi-language coupon name
  name                  Json         @db.JsonB
  /// Multi-language description
  description           Json?        @db.JsonB
  /// Multi-language terms
  terms                 Json?        @db.JsonB
  /// Coupon type: discount, cash_voucher, free_item, service, stamp_multiplier
  couponType            String       @db.VarChar(50)
  /// Discount value or cash amount
  value                 Decimal?     @db.Decimal(15, 2)
  /// Discount percentage (if percentage-based)
  discountPercent       Decimal?     @db.Decimal(5, 2)
  /// Minimum spending to use coupon
  minSpending           Decimal?     @db.Decimal(15, 2)
  image                 String?      @db.VarChar(500)
  /// Stamps required to redeem this coupon (0 = free coupon)
  stampCost             Int          @default(0)
  /// Total quantity available
  totalQuantity         Int
  /// Remaining quantity
  remainingQuantity     Int
  /// Max per member
  maxPerMember          Int          @default(1)
  /// Applicable merchant IDs (empty = all)
  applicableMerchantIds String[]
  status                CouponStatus @default(ACTIVE)
  effectiveFrom         DateTime
  effectiveTo           DateTime
  /// Validity days after issuance (for issued coupons)
  validityDays          Int?
  /// Barcode/QR for coupon usage
  barcodePrefix         String?      @db.VarChar(50)
  /// Additional config
  metadata              Json?        @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  group           Group            @relation(fields: [groupId], references: [id])
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  couponInstances CouponInstance[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([campaignId])
  @@index([couponType])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
  @@map("coupons")
}

/// CouponInstance - Issued coupons to members.
model CouponInstance {
  id                 String               @id @default(uuid()) @db.Uuid
  couponId           String               @db.Uuid
  memberId           String               @db.Uuid
  instanceCode       String               @unique @db.VarChar(100)
  status             CouponInstanceStatus @default(AVAILABLE)
  /// Barcode for physical/digital usage
  barcode            String?              @db.VarChar(200)
  qrCode             String?              @db.VarChar(500)
  issuedAt           DateTime             @default(now())
  usedAt             DateTime?
  expiresAt          DateTime
  /// Where it was used
  usedAtMerchantId   String?              @db.Uuid
  /// Transaction reference
  usedTransactionRef String?              @db.VarChar(200)
  /// Stamps spent to acquire this coupon
  stampsSpent        Int                  @default(0)
  /// Additional metadata
  metadata           Json?                @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id])
