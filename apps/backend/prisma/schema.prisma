enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FeedbackCategory {
  GENERAL
  COMPLAINT
  SUGGESTION
  INQUIRY
  PRAISE
  OTHER
}

/// Feedback - Customer feedback/AI conversation sessions.
model Feedback {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @db.Uuid
  memberId    String?          @db.Uuid
  /// Session/conversation title (auto-generated or from first message)
  title       String?          @db.VarChar(500)
  category    FeedbackCategory @default(GENERAL)
  status      FeedbackStatus   @default(OPEN)
  /// Priority: 1=low, 2=normal, 3=high, 4=urgent
  priority    Int              @default(2)
  /// Rating from customer (1-5)
  rating      Int?
  /// Summary generated by AI
  aiSummary   String?          @db.Text
  /// Tags for categorization
  tags        String[]
  /// Assigned staff member
  assignedTo  String?          @db.Uuid
  resolvedAt  DateTime?
  resolvedBy  String?          @db.Uuid
  /// Anonymous feedback (no member login)
  isAnonymous Boolean          @default(false)
  /// Contact info for anonymous feedback
  contactInfo Json?            @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project  Project           @relation(fields: [projectId], references: [id])
  member   Member?           @relation(fields: [memberId], references: [id])
  messages FeedbackMessage[]

  @@index([projectId])
  @@index([memberId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("feedbacks")
}

enum FeedbackMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// FeedbackMessage - Individual messages in feedback conversation.
model FeedbackMessage {
  id         String              @id @default(uuid()) @db.Uuid
  feedbackId String              @db.Uuid
  role       FeedbackMessageRole
  content    String              @db.Text
  /// AI model used (e.g., "glm-4-flash")
  aiModel    String?             @db.VarChar(100)
  /// Token usage for AI messages
  tokens     Int?
  /// Metadata (intent, entities, context used, etc.)
  metadata   Json?               @db.JsonB

  createdAt DateTime @default(now())

  // Relations
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([role])
  @@index([createdAt])
  @@map("feedback_messages")
}

/// SmsSendRecord - SMS sending records for tracking and billing.
model SmsSendRecord {
  id                String             @id @default(uuid()) @db.Uuid
  /// Recipient phone number
  phone             String             @db.VarChar(50)
  countryCode       String             @default("+852") @db.VarChar(10)
  /// Message content
