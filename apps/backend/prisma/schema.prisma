  entryTime       DateTime
  /// Exit time (null if still parked)
  exitTime        DateTime?
  /// Duration in minutes
  duration        Int?
  /// Original fee before any discounts
  originalFee     Decimal              @db.Decimal(10, 2)
  /// Discount amount (member discount, stamps, etc.)
  discountAmount  Decimal              @default(0) @db.Decimal(10, 2)
  /// Final fee after discounts
  finalFee        Decimal              @db.Decimal(10, 2)
  /// Stamps used for payment
  stampsUsed      Int                  @default(0)
  /// Free parking hours used (from membership tier)
  freeHoursUsed   Decimal              @default(0) @db.Decimal(4, 2)
  /// Payment status
  paymentStatus   ParkingPaymentStatus @default(PENDING)
  /// Payment method
  paymentMethod   ParkingPaymentMethod?
  /// Payment transaction ID
  paymentTxnId    String?              @db.VarChar(255)
  /// Paid at
  paidAt          DateTime?
  /// Parking lot/zone identifier
  parkingZone     String?              @db.VarChar(50)
  /// Floor/level
  floor           String?              @db.VarChar(20)
  /// Spot number
  spotNumber      String?              @db.VarChar(20)
  /// Notes
  notes           String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id])
  member  Member? @relation(fields: [memberId], references: [id])

  @@index([projectId])
  @@index([memberId])
  @@index([licensePlate])
  @@index([paymentStatus])
  @@index([entryTime])
  @@map("parking_records")
}

/// ParkingRate - Parking rate configuration per project.
model ParkingRate {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  /// Rate name (e.g., "Weekday", "Weekend", "Holiday")
  name          Json     @db.JsonB
  /// Rate per hour in HKD
  hourlyRate    Decimal  @db.Decimal(10, 2)
  /// First N hours free/discounted
  freeHours     Decimal  @default(0) @db.Decimal(4, 2)
  /// Maximum daily charge
  maxDailyRate  Decimal? @db.Decimal(10, 2)
  /// Days applicable (0=Sunday, 1=Monday, etc.)
  applicableDays Int[]
  /// Time range start (e.g., "08:00")
  startTime     String?  @db.VarChar(10)
  /// Time range end (e.g., "22:00")
  endTime       String?  @db.VarChar(10)
  /// Member tier discounts (JSON: { "GOLD": 0.2, "PLATINUM": 0.3 })
  tierDiscounts Json?    @db.JsonB
  /// Stamps per HKD spent on parking
  stampsPerDollar Decimal @default(0) @db.Decimal(5, 2)
  /// Stamps to HKD conversion for payment (e.g., 10 stamps = 1 HKD)
  stampsToHkdRate Decimal @default(10) @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  priority      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([isActive])
  @@map("parking_rates")
}

// ============================================================================
// SMART MARKETING - Auto-Tag Rules / Triggers / Segments / Journeys
// ============================================================================

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// AutoTagRule - Automatic member tagging rules based on configurable conditions.
model AutoTagRule {
  id             String    @id @default(uuid()) @db.Uuid
  groupId        String    @db.Uuid
  projectId      String?   @db.Uuid
  code           String    @db.VarChar(50)
  /// Multi-language rule name
  name           Json      @db.JsonB
  /// Tag to apply when conditions are met
  tagId          String    @db.Uuid
  /// Evaluation conditions (JSON array of TagCondition objects)
  conditions     Json      @db.JsonB
  isActive       Boolean   @default(true)
  priority       Int       @default(0)
  lastExecutedAt DateTime?
  executionCount Int       @default(0)
  /// Additional metadata (conditionLogic, autoRemove, evaluationFrequency, stats, etc.)
  metadata       Json      @default("{}") @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tag MemberLabel @relation(fields: [tagId], references: [id])

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([tagId])
  @@index([isActive])
  @@map("auto_tag_rules")
}

/// MarketingTrigger - Event/schedule/condition-based marketing trigger rules.
model MarketingTrigger {
  id                   String    @id @default(uuid()) @db.Uuid
  groupId              String    @db.Uuid
  projectId            String?   @db.Uuid
  code                 String    @db.VarChar(50)
  /// Multi-language trigger name
  name                 Json      @db.JsonB
  /// Event type that this trigger listens for
  eventType            String    @db.VarChar(100)
  /// Conditions for trigger evaluation (JSON)
  conditions           Json      @default("{}") @db.JsonB
  /// Actions to execute when triggered (JSON array of MarketingAction)
  actions              Json      @default("[]") @db.JsonB
  isActive             Boolean   @default(true)
  /// Min minutes between triggers for same member
  cooldownMinutes      Int       @default(0)
  /// Max times this trigger can fire for a single member
  maxTriggersPerMember Int?
  /// Audience filter (JSON)
  audienceFilter       Json      @default("{}") @db.JsonB
  /// Schedule configuration (JSON, for schedule-based triggers)
  schedule             Json      @default("{}") @db.JsonB
  /// A/B test configuration (JSON)
  abTestConfig         Json      @default("{}") @db.JsonB
  /// Additional metadata (triggerType, description, validDateRange, etc.)
  metadata             Json      @default("{}") @db.JsonB
  executionCount       Int       @default(0)
  lastTriggeredAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([eventType])
  @@index([isActive])
  @@map("marketing_triggers")
}

/// MemberSegment - Dynamic or static member segments for targeting.
model MemberSegment {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  projectId   String?   @db.Uuid
  code        String    @db.VarChar(50)
  /// Multi-language segment name
  name        Json      @db.JsonB
  /// Multi-language description
  description Json      @default("{}") @db.JsonB
  /// Segment rules (JSON array of TagCondition objects)
  rules       Json      @default("[]") @db.JsonB
  /// Current member count matching this segment
  memberCount Int       @default(0)
  isActive    Boolean   @default(true)
  refreshedAt DateTime?
  /// Additional metadata (ruleLogic, isDynamic, etc.)
  metadata    Json      @default("{}") @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([isActive])
  @@map("member_segments")
}

/// MemberJourney - Automated multi-step member journey workflows.
model MemberJourney {
  id                String        @id @default(uuid()) @db.Uuid
  groupId           String        @db.Uuid
  projectId         String?       @db.Uuid
  code              String        @db.VarChar(50)
  /// Multi-language journey name
  name              Json          @db.JsonB
  /// Multi-language description
  description       Json          @default("{}") @db.JsonB
  status            JourneyStatus @default(DRAFT)
  /// Trigger conditions for journey entry (JSON)
  triggerConditions Json          @default("{}") @db.JsonB
  /// Journey steps (JSON array of JourneyStep)
  steps             Json          @default("[]") @db.JsonB
  /// Number of members who have entered the journey
  entryCount        Int           @default(0)
  /// Number of members who have completed the journey
  completionCount   Int           @default(0)
  /// Additional metadata (exitConditions, maxConcurrentMembers, validDateRange, stats, etc.)
  metadata          Json          @default("{}") @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([groupId, code])
  @@index([groupId])
  @@index([projectId])
  @@index([status])
  @@map("member_journeys")
}
