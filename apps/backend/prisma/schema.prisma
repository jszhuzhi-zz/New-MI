}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum BannerPosition {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
  CATEGORY_TOP
  DETAIL_PAGE
  POPUP
  SPLASH
}

enum NotificationChannel {
