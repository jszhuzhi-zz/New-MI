/// InterfaceMonitor - Third-party interface health monitoring.
model InterfaceMonitor {
  id                  String          @id @default(uuid()) @db.Uuid
  groupId             String          @db.Uuid
  /// Interface name (e.g., "Payment Gateway", "SMS Provider", "M365 Auth")
  name                String          @db.VarChar(200)
  /// Interface URL or endpoint
  endpoint            String          @db.VarChar(500)
  /// HTTP method
  method              String          @default("GET") @db.VarChar(10)
  /// Current status
  status              InterfaceStatus @default(UNKNOWN)
  /// Response time in milliseconds
  responseTimeMs      Int?
  /// Last successful check
  lastSuccessAt       DateTime?
  /// Last failure
  lastFailureAt       DateTime?
  /// Last error message
  lastErrorMessage    String?         @db.Text
  /// Check interval in seconds
  checkIntervalSec    Int             @default(300)
  /// Alert threshold (consecutive failures)
  alertThreshold      Int             @default(3)
  /// Current consecutive failure count
  consecutiveFailures Int             @default(0)
  /// Alert recipients (JSON array of emails/phones)
  alertRecipients     Json?           @db.JsonB
  isActive            Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([status])
  @@map("interface_monitors")
}

/// ReportDownload - Export/download history for reports and data.
model ReportDownload {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  /// Report type: member_list, transaction_report, campaign_analytics, etc.
  reportType   String       @db.VarChar(100)
  /// Multi-language report name
  name         Json?        @db.JsonB
  /// Filter parameters used
  parameters   Json?        @db.JsonB
  /// File format: xlsx, csv, pdf
  fileFormat   String       @db.VarChar(10)
  /// File URL (after generation)
  fileUrl      String?      @db.VarChar(500)
  /// File size in bytes
  fileSize     BigInt?
  status       ReportStatus @default(PENDING)
  /// Processing progress (0-100)
  progress     Int          @default(0)
  /// Error message if failed
  errorMessage String?      @db.Text
  /// Expiry time for download link
  expiresAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([reportType])
  @@index([status])
  @@index([createdAt])
  @@map("report_downloads")
}

/// OperationLog - Detailed operation audit trail.
model OperationLog {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String? @db.Uuid
  /// Module: member, stamp, campaign, merchant, system, etc.
  module       String  @db.VarChar(100)
  /// Operation: create, update, delete, approve, reject, import, export, etc.
  operation    String  @db.VarChar(100)
  /// Target entity type
  entityType   String? @db.VarChar(100)
  /// Target entity ID
  entityId     String? @db.VarChar(255)
  /// Multi-language description of the operation
  description  Json?   @db.JsonB
  /// Request/response details
  requestData  Json?   @db.JsonB
  responseData Json?   @db.JsonB
  /// Result: success, failure, partial
  result       String  @default("success") @db.VarChar(20)
  /// Error details if failed
  errorMessage String? @db.Text
  /// Client info
  ipAddress    String? @db.VarChar(45)
  userAgent    String? @db.Text
  /// Duration in milliseconds
  durationMs   Int?

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([operation])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("operation_logs")
}

