{
  "envId": "georgezhu-0gnrnw9ae9fca59a",
  "version": "2.0",
  "framework": {
    "name": "link-reit-membership",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "apps/customer-web/dist",
          "cloudPath": "/"
        }
      },
      "mall-admin": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "apps/mall-admin/dist",
          "cloudPath": "/mall-admin"
        }
      },
      "merchant-portal": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "apps/merchant-portal/dist",
          "cloudPath": "/merchant-portal"
        }
      },
      "group-admin": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "apps/group-admin/dist",
          "cloudPath": "/group-admin"
        }
      },
      "server": {
        "use": "@cloudbase/framework-plugin-function",
        "inputs": {
          "functions": [{
            "name": "link-reit-api",
            "runtime": "Nodejs18.15",
            "handler": "index.main",
            "timeout": 60,
            "memorySize": 512,
            "installDependency": true,
            "codeSecret": ""
          }],
          "servicePaths": {
            "link-reit-api": "/api"
          },
          "functionRootPath": "apps/backend/scf"
        }
      }
    }
  }
}
